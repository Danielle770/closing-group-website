# The Closing Group API settings.
# setup.sh copies this to /etc/closinggroup/closinggroup.env (outside the website folder).
# Fill in the values there, never in this file, and never commit real secrets.

PORT=3100
SITE_URL=https://closinggroupisrael.com
DB_PATH=/var/lib/closinggroup/members.db

# --- Email ---
# Option A (recommended on DigitalOcean, where mail ports are blocked): an email API over HTTPS.
# Set ONE of these keys. MAIL_FROM must be an address the service has verified.
RESEND_API_KEY=
BREVO_API_KEY=

# Replies to our emails go here
REPLY_TO=closinggroupisrael@gmail.com

# Option B: SMTP (only works if the server can reach mail ports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=closinggroupisrael@gmail.com
SMTP_PASS=
MAIL_FROM=The Closing Group <closinggroupisrael@gmail.com>

# Where new-member notifications go
ADMIN_EMAIL=closinggroupisrael@gmail.com

# Password for downloading the member list at /api/admin/members.csv (username: admin)
ADMIN_PASSWORD=

# --- WhatsApp verification codes (Twilio Verify, WhatsApp channel) ---
# Leave empty to skip WhatsApp codes; members can still join with email verification.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
