# The Closing Group API settings.
# setup.sh copies this to /etc/closinggroup/closinggroup.env (outside the website folder).
# Fill in the values there, never in this file, and never commit real secrets.

PORT=3100
SITE_URL=https://closinggroupisrael.com
DB_PATH=/var/lib/closinggroup/members.db

# --- Email ---
# Option A (recommended on DigitalOcean, where mail ports are blocked): an email API over HTTPS.
# Set ONE of these keys. MAIL_FROM must be an address the service has verified.
RESEND_API_KEY=
BREVO_API_KEY=

# Replies to our emails go here
REPLY_TO=closinggroupisrael@gmail.com

# Option B: SMTP (only works if the server can reach mail ports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=closinggroupisrael@gmail.com
SMTP_PASS=
MAIL_FROM=The Closing Group <closinggroupisrael@gmail.com>

# Where new-member notifications go
ADMIN_EMAIL=closinggroupisrael@gmail.com

# Password for downloading the member list at /api/admin/members.csv (username: admin)
ADMIN_PASSWORD=

# --- WhatsApp verification codes (Twilio Verify, WhatsApp channel) ---
# Leave empty to skip WhatsApp codes; members can still join with email verification.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Apartment chat ("Ask us about Apartment 65") ---
# The website folder: the agent reads the Q&A, the apartment facts and the pages from here (setup.sh fills it in).
SITE_DIR=/var/www/closinggroupisrael.com
# AI answers. Without a key the chat still works, answering from the Q&A and the apartment facts in the browser.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
# Every lead card is emailed to ADMIN_EMAIL. To ALSO receive it on the company WhatsApp (uses the Twilio account above):
#   TWILIO_WHATSAPP_FROM  = our WhatsApp sender number on Twilio, e.g. +14155238886
#   COMPANY_WHATSAPP      = the company WhatsApp that receives leads, e.g. +972542222504
#   TWILIO_WHATSAPP_CONTENT_SID = an approved WhatsApp template with one variable {{1}} (WhatsApp only allows
#     free text within 24 hours of the company number last writing to the sender; a template works any time)
TWILIO_WHATSAPP_FROM=
COMPANY_WHATSAPP=
TWILIO_WHATSAPP_CONTENT_SID=
